# syntax=docker/dockerfile:1.7

FROM rust:1.96-bookworm AS employee-runtime-builder

WORKDIR /build
COPY apps/employee-runtime/Cargo.toml ./Cargo.toml
COPY apps/employee-runtime/Cargo.lock ./Cargo.lock
COPY apps/employee-runtime/src ./src
RUN cargo build --release --locked

FROM ubuntu:24.04

ARG NODE_MAJOR=22
ARG RUST_TOOLCHAIN=1.96.1
ARG AGENT_UID=10001
ARG AGENT_GID=10001

LABEL org.opencontainers.image.title="AI Company Employee Runtime"
LABEL org.opencontainers.image.description="Ubuntu-based employee workspace with Python, Node.js, Rust, and Azul Zulu JDK 21"

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Asia/Shanghai \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    NPM_CONFIG_PREFIX=/opt/npm \
    VIRTUAL_ENV=/opt/python-venv \
    JAVA_HOME=/opt/java

ENV PATH="${VIRTUAL_ENV}/bin:${NPM_CONFIG_PREFIX}/bin:${CARGO_HOME}/bin:${JAVA_HOME}/bin:${PATH}"

# 基础开发工具与 Python 3。
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        libssl-dev \
        openssh-client \
        pkg-config \
        python3 \
        python3-pip \
        python3-venv \
        tini \
        unzip \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Node.js。NODE_MAJOR 可在构建时覆盖，例如：--build-arg NODE_MAJOR=24。
RUN install -d -m 0755 /etc/apt/keyrings \
    && curl --fail --silent --show-error --location \
        https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor --output /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install --yes --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Azul Zulu JDK 21。
RUN curl --fail --silent --show-error --location https://repos.azul.com/azul-repo.key \
        | gpg --dearmor --output /etc/apt/keyrings/azul.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/azul.gpg] https://repos.azul.com/zulu/deb stable main" \
        > /etc/apt/sources.list.d/zulu.list \
    && apt-get update \
    && apt-get install --yes --no-install-recommends zulu21-jdk \
    && java_home_path="$(dirname "$(dirname "$(readlink -f /usr/bin/java)")")" \
    && ln -s "${java_home_path}" "${JAVA_HOME}" \
    && rm -rf /var/lib/apt/lists/*

# Rust 使用 rustup 安装，后续可通过 RUST_TOOLCHAIN 固定具体版本。
RUN install -d -m 0755 "${RUSTUP_HOME}" "${CARGO_HOME}" \
    && curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
        https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "${RUST_TOOLCHAIN}" \
    && rustup component add rustfmt clippy

# Python 使用独立虚拟环境，避免 Ubuntu 的 externally-managed Python 限制。
RUN python3 -m venv "${VIRTUAL_ENV}" \
    && pip install --no-cache-dir --upgrade pip setuptools wheel

COPY --from=employee-runtime-builder /build/target/release/employee-runtime /usr/local/bin/employee-runtime

# 这些是镜像内默认目录；运行时会被宿主机员工目录的 bind mount 覆盖。
RUN groupadd --gid "${AGENT_GID}" agent \
    && useradd --uid "${AGENT_UID}" --gid "${AGENT_GID}" \
        --create-home --shell /bin/bash agent \
    && install -d -o agent -g agent -m 0755 /workspace /agent-state /artifacts "${NPM_CONFIG_PREFIX}" \
    && chown -R agent:agent \
        "${RUSTUP_HOME}" \
        "${CARGO_HOME}" \
        "${VIRTUAL_ENV}"

RUN python3 --version \
    && node --version \
    && npm --version \
    && rustc --version \
    && cargo --version \
    && java -version

USER agent
WORKDIR /workspace

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/sleep", "infinity"]
