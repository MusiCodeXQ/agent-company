# Rust server
HOST=0.0.0.0
PORT=3001
DATABASE_URL=sqlite://data/ai_company.db?mode=rwc
# 用于加密 Provider API Key；请替换为本机自己的随机长字符串，不要提交真实密钥。
MODEL_PROFILE_ENCRYPTION_KEY=replace-with-a-local-secret
# 可选：启用后，已 Provision 的员工会通过 OpenClaw Gateway 处理消息。
# 不启用时使用内置 Mock / OpenAI Compatible Provider，OpenClaw 不需要安装。
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_PROTOCOL_VERSION=4
OPENCLAW_WORKSPACE_ROOT=data/openclaw/workspaces

# 可选：每员工独立 ADK-Rust + Docker Runtime。默认关闭，Mock 模式不需要 Docker。
# 先在项目根目录执行：
# docker build -f Dockerfile.employee -t ai-company/employee-base:debian-stable .
AI_COMPANY_DOCKER_ENABLED=false
AI_COMPANY_DOCKER_BIN=docker
AI_COMPANY_EMPLOYEE_IMAGE=ai-company/employee-base:debian-stable
# 每位员工在该目录下拥有 workspace/state/artifacts/environment 四个子目录。
# 可以填 WSL 绝对路径；相对路径按 Rust Server 的工作目录解析。
AI_COMPANY_EMPLOYEE_ROOT=data/employee-runtimes
AI_COMPANY_EMPLOYEE_CPUS=2
AI_COMPANY_EMPLOYEE_MEMORY=2g
AI_COMPANY_EMPLOYEE_PIDS=512
# 诊断开关：true 时保留停止的员工容器，超时先 stop/kill 再回收 CLI，并在启动时停止仍运行的 stale 容器但不删除。
AI_COMPANY_DOCKER_KEEP_CONTAINERS=false
